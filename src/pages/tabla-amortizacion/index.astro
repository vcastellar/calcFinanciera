---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorPage from '@/components/CalculatorPage.astro';
import FinancialCalculator from '@/components/FinancialCalculator.astro';
const fields = [{id:'principal',label:'Importe del préstamo',value:20000},{id:'rate',label:'Interés anual (%)',value:6},{id:'years',label:'Plazo (años)',value:5}];
---
<BaseLayout title="Tabla de amortización" description="Consulta cómo se reparte cada cuota entre intereses y capital pendiente.">
  <CalculatorPage title="Tabla de amortización" intro="Consulta cómo se reparte cada cuota entre intereses y capital pendiente." formula="Interés mensual = saldo pendiente × i mensual" example="Para 20.000 € al 6 % a 5 años se listan cuotas, intereses, capital amortizado y saldo." faqs={[{question:'¿El resultado es definitivo?',answer:'No. Es una estimación educativa basada en los datos introducidos.'},{question:'¿Qué tipo de interés debo usar?',answer:'Usa el tipo nominal anual cuando el formulario pida interés anual.'}]}>
    <FinancialCalculator slot="calculator" kind="amortization" fields={fields} />
  </CalculatorPage>
</BaseLayout>
