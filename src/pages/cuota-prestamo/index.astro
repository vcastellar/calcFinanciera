---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorPage from '@/components/CalculatorPage.astro';
import FinancialCalculator from '@/components/FinancialCalculator.astro';
const fields = [{id:'principal',label:'Importe del préstamo',value:20000},{id:'rate',label:'Interés anual (%)',value:6},{id:'years',label:'Plazo (años)',value:5}];
---
<BaseLayout title="Calculadora de cuota de préstamo" description="Estima la cuota mensual de un préstamo con sistema francés.">
  <CalculatorPage title="Calculadora de cuota de préstamo" intro="Estima la cuota mensual de un préstamo con sistema francés." formula="C = P × i / (1 - (1 + i)^-n)" example="Un préstamo de 20.000 € al 6 % durante 5 años devuelve cuota, total pagado e intereses." faqs={[{question:'¿El resultado es definitivo?',answer:'No. Es una estimación educativa basada en los datos introducidos.'},{question:'¿Qué tipo de interés debo usar?',answer:'Usa el tipo nominal anual cuando el formulario pida interés anual.'}]}>
    <FinancialCalculator slot="calculator" kind="loan" fields={fields} />
  </CalculatorPage>
</BaseLayout>
