---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorPage from '@/components/CalculatorPage.astro';
import FinancialCalculator from '@/components/FinancialCalculator.astro';
const fields = [{id:'target',label:'Objetivo de ahorro',value:30000},{id:'initial',label:'Capital inicial',value:2000},{id:'rate',label:'Rentabilidad anual estimada (%)',value:3},{id:'years',label:'Plazo (años)',value:5}];
---
<BaseLayout title="Calculadora de objetivo de ahorro" description="Descubre cuánto aportar cada mes para alcanzar una cantidad objetivo.">
  <CalculatorPage title="Calculadora de objetivo de ahorro" intro="Descubre cuánto aportar cada mes para alcanzar una cantidad objetivo." formula="PMT = (objetivo - capital inicial capitalizado) × i / ((1 + i)^n - 1)" example="Para ahorrar 30.000 € en 5 años con 2.000 € iniciales y 3 % anual se estima la aportación mensual." faqs={[{question:'¿El resultado es definitivo?',answer:'No. Es una estimación educativa basada en los datos introducidos.'},{question:'¿Qué tipo de interés debo usar?',answer:'Usa el tipo nominal anual cuando el formulario pida interés anual.'}]}>
    <FinancialCalculator slot="calculator" kind="savings" fields={fields} />
  </CalculatorPage>
</BaseLayout>
