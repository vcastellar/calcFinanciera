---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorPage from '@/components/CalculatorPage.astro';
import FinancialCalculator from '@/components/FinancialCalculator.astro';
const fields = [{id:'price',label:'Precio de la vivienda',value:250000},{id:'down',label:'Entrada (%)',value:20},{id:'costs',label:'Gastos estimados (%)',value:10},{id:'rate',label:'Interés anual (%)',value:3.5},{id:'years',label:'Plazo (años)',value:30}];
---
<BaseLayout title="Calculadora de hipoteca" description="Calcula cuota hipotecaria, entrada, gastos estimados y porcentaje financiado.">
  <CalculatorPage title="Calculadora de hipoteca" intro="Calcula cuota hipotecaria, entrada, gastos estimados y porcentaje financiado." formula="Principal = precio - entrada; cuota con sistema francés" example="Una vivienda de 250.000 €, entrada del 20 %, gastos del 10 % y 30 años estima efectivo necesario y cuota." faqs={[{question:'¿El resultado es definitivo?',answer:'No. Es una estimación educativa basada en los datos introducidos.'},{question:'¿Qué tipo de interés debo usar?',answer:'Usa el tipo nominal anual cuando el formulario pida interés anual.'}]}>
    <FinancialCalculator slot="calculator" kind="mortgage" fields={fields} />
  </CalculatorPage>
</BaseLayout>
