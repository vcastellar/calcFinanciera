---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorPage from '@/components/CalculatorPage.astro';
import FinancialCalculator from '@/components/FinancialCalculator.astro';
const fields = [{id:'initial',label:'Capital inicial',value:10000},{id:'contribution',label:'Aportación mensual',value:200},{id:'rate',label:'Interés anual (%)',value:5},{id:'years',label:'Plazo (años)',value:10}];
---
<BaseLayout title="Calculadora de interés compuesto" description="Calcula el valor futuro de un capital con aportaciones mensuales e interés compuesto.">
  <CalculatorPage title="Calculadora de interés compuesto" intro="Calcula el valor futuro de un capital con aportaciones mensuales e interés compuesto." formula="VF = capital y aportaciones acumuladas × (1 + i)^n" example="10.000 € iniciales, 200 € al mes, 5 % anual y 10 años muestran saldo final, aportado e intereses." faqs={[{question:'¿El resultado es definitivo?',answer:'No. Es una estimación educativa basada en los datos introducidos.'},{question:'¿Qué tipo de interés debo usar?',answer:'Usa el tipo nominal anual cuando el formulario pida interés anual.'}]}>
    <FinancialCalculator slot="calculator" kind="compound" fields={fields} />
  </CalculatorPage>
</BaseLayout>
